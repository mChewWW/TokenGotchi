# ---------------------------------------------------------------------------
# TokenGotchi
#
# The repository holds only what is needed to read, test, and build the game:
# source, tests, assets, packaging metadata, build scripts, README, licence.
# Everything regenerable, machine-local, or private is excluded below.
# ---------------------------------------------------------------------------

# --- Python bytecode -------------------------------------------------------
# *.py[cod] covers .pyc, .pyo and .pyd; no separate rules needed.
__pycache__/
*.py[cod]
.Python

# --- Packaging & build artefacts -------------------------------------------
# Regenerated by `pip install -e .` and by PyInstaller.
build/
dist/
*.egg
*.egg-info/
.eggs/
*.whl
pip-wheel-metadata/

# --- PyInstaller -----------------------------------------------------------
# Deliberately NO `*.spec` rule. Both spec files are build INPUTS, not output:
# scripts/build.bat and scripts/build.sh run `pyinstaller tokengotchi.spec`,
# and TokenGotchi_debug.spec is the console-enabled variant. Ignoring them
# breaks the build on any fresh clone.

# Stray executables. The shipped binary is built into dist/ (ignored above)
# and published as a GitHub release asset; it is never committed.
*.exe

# --- Virtual environments --------------------------------------------------
venv/
env/
.venv/

# --- Secrets ---------------------------------------------------------------
# Bare `.env` matches both a file and a directory of that name.
.env
.env.local

# --- Testing & coverage ----------------------------------------------------
# pyproject.toml sets addopts = "--cov=...", so coverage output always appears.
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# --- Type checkers & linters -----------------------------------------------
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- Editors ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating system ------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Cloud-sync scratch ----------------------------------------------------
# Conflict copies and partial downloads left behind by cloud-sync clients.
*conflicted copy*
*conflicted_copy*
*.tmp
*.partial
~$*

# --- Logs ------------------------------------------------------------------
*.log

# --- Local-only ------------------------------------------------------------
# Working notes, scratch artwork and editor config. Machine-specific, and not
# needed to build or run the game.
.bureau/
memory/
.claude/
